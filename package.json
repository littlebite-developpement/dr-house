{
  "name": "dr-house",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "mobile",
    "desktop",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "bun run --filter dr-house-desktop tauri dev",
    "dev:mobile": "bun run --filter dr-house-mobile tauri dev",
    "build:desktop": "bun run --filter dr-house-desktop tauri build",
    "build:mobile": "bun run --filter dr-house-mobile tauri build",
    "dev:backend": "bun run --filter dr-house-backend dev",
    "install:backend": "bun install --filter dr-house-backend",
    "install:desktop": "bun install --filter dr-house-desktop",
    "install:mobile": "bun install --filter dr-house-mobile"
  },
  "devDependencies": {
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
  }
}
